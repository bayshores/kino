# Development-only optional settings. No API key is required.
MOTION_HOST=127.0.0.1
MOTION_API_PORT=4781
# KINO_DEV_PORT=4173  (npm run dev only; set it in the shell, as Vite does not read .env for this)
# MOTION_DATA_DIR=/absolute/path/to/private/project-data
# KINO_FFMPEG=/absolute/path/to/ffmpeg
# KINO_FFPROBE=/absolute/path/to/ffprobe
# KINO_GIFSKI=/absolute/path/to/gifski
# At most this many Chromium workers draw a movie export's frames at once (default 1; up to 8, and
# fewer when the processor cores or free memory are short; see docs/running.md).
# KINO_RASTER_WORKERS=2
# Draw exports without the graphics processor, as a computer without one does (slower, and the
# frames do not have the same pixels as the graphics processor's).
# KINO_RASTER_GPU=off
# MOTION_API_URL=http://127.0.0.1:4781
# For a reachable host, set its origin and a private host key. Guest links need no account.
# KINO_PUBLIC_URL=https://your-kino-host.example
# KINO_OWNER_TOKEN=replace-with-a-random-private-host-key
# An MCP client may use a scoped link instead of the host key:
# KINO_SHARE_TOKEN=the-token-after-share-in-your-link
