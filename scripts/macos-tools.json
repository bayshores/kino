{
  "schemaVersion": 1,
  "target": {
    "platform": "darwin",
    "architecture": "arm64",
    "minimumMacOS": "13.0",
    "libvpxTarget": "arm64-darwin25-gcc",
    "jobs": 2
  },
  "requiredCodecs": {
    "encoders": [
      "png",
      "apng",
      "gif",
      "libx264",
      "h264_videotoolbox",
      "libvpx-vp9",
      "libopus",
      "aac",
      "prores_ks"
    ],
    "decoders": [
      "png",
      "apng",
      "gif",
      "mjpeg",
      "h264",
      "hevc",
      "vp8",
      "vp9",
      "libvpx-vp9",
      "prores",
      "aac",
      "opus"
    ]
  },
  "tools": {
    "ffmpeg": {
      "version": "9.0.2",
      "url": "https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz",
      "sha256": "8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e",
      "signatureUrl": "https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz.asc",
      "signingKeyUrl": "https://ffmpeg.org/ffmpeg-devel.asc",
      "signingKeyFingerprint": "FCF986EA15E6E293A5644F10B4322F04D67658D8",
      "license": "GPL-2.0-or-later",
      "configureArgs": [
        "--prefix={stage}",
        "--pkg-config={pkgConfig}",
        "--pkg-config-flags=--static",
        "--extra-cflags=-I{stage}/include",
        "--extra-ldflags=-L{stage}/lib",
        "--enable-gpl",
        "--enable-zlib",
        "--disable-autodetect",
        "--enable-static",
        "--disable-shared",
        "--enable-pic",
        "--disable-ffplay",
        "--disable-doc",
        "--enable-ffmpeg",
        "--enable-ffprobe",
        "--enable-libx264",
        "--enable-libvpx",
        "--enable-libopus",
        "--enable-videotoolbox",
        "--enable-audiotoolbox"
      ]
    },
    "x264": {
      "version": "r3222",
      "commit": "b35605ace3ddf7c1a5d67a2eb553f034aef41d55",
      "url": "https://code.videolan.org/videolan/x264/-/archive/b35605ace3ddf7c1a5d67a2eb553f034aef41d55/x264-b35605ace3ddf7c1a5d67a2eb553f034aef41d55.tar.gz",
      "sha256": "cd71a7515b0e9a012e1ac9b1f8415bebcaf6fc97d4db32286642ac4c0fbe24f9",
      "license": "GPL-2.0-or-later",
      "configureArgs": [
        "--prefix={stage}",
        "--enable-static",
        "--disable-shared",
        "--enable-pic",
        "--disable-cli"
      ]
    },
    "libvpx": {
      "version": "1.17.0",
      "url": "https://github.com/webmproject/libvpx/archive/refs/tags/v1.17.0.tar.gz",
      "sha256": "1020f184046187baa2985dbde38e0691f49c44088bca7a1842b0236c6081dc0a",
      "license": "BSD-3-Clause",
      "configureArgs": [
        "--target={libvpxTarget}",
        "--prefix={stage}",
        "--enable-static",
        "--disable-shared",
        "--enable-pic",
        "--disable-examples",
        "--disable-tools",
        "--disable-unit-tests",
        "--enable-vp9-highbitdepth"
      ]
    },
    "opus": {
      "version": "1.6.1",
      "url": "https://ftp.osuosl.org/pub/xiph/releases/opus/opus-1.6.1.tar.gz",
      "sha256": "6ffcb593207be92584df15b32466ed64bbec99109f007c82205f0194572411a1",
      "license": "BSD-3-Clause",
      "configureArgs": [
        "--prefix={stage}",
        "--enable-static",
        "--disable-shared",
        "--disable-doc",
        "--disable-extra-programs",
        "--disable-tests"
      ]
    },
    "pkgconf": {
      "version": "2.5.1",
      "url": "https://distfiles.ariadne.space/pkgconf/pkgconf-2.5.1.tar.xz",
      "sha256": "cd05c9589b9f86ecf044c10a2269822bc9eb001eced2582cfffd658b0a50c243",
      "license": "ISC AND BSD-4-Clause AND BSD-2-Clause AND MIT",
      "buildOnly": true,
      "configureArgs": [
        "--prefix={pkgconfPrefix}",
        "--enable-static",
        "--disable-shared"
      ]
    },
    "gifski": {
      "version": "1.34.0",
      "url": "https://github.com/ImageOptim/gifski/archive/refs/tags/1.34.0.tar.gz",
      "sha256": "c9711473615cb20d7754e8296621cdd95cc068cb04b640f391cd71f8787b692c",
      "cargoLockSha256": "d407a44d19ad1527baccdc5a07477cdba2872dc60bb09f2c524503dd26a3ce2f",
      "license": "AGPL-3.0-or-later",
      "cargoFeatures": ["binary", "gifsicle"],
      "cargoArgs": [
        "--locked",
        "--offline",
        "--release",
        "--target=aarch64-apple-darwin",
        "--no-default-features",
        "--features=binary,gifsicle"
      ]
    }
  }
}
